{
    "app-id": "com.github.ztefn.haguichi",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "haguichi",
    "finish-args": [
        "--device=dri",

        "--filesystem=/var/lib/logmein-hamachi:ro",

        "--system-talk-name=org.freedesktop.login1",

        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.kde.StatusNotifierWatcher",

        "--share=network",
        "--share=ipc",

        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/share/gir-1.0",
        "/share/vala"
    ],
    "modules": [
        {
            "name": "libportal",
            "buildsystem": "meson",
            "config-opts": [
                "-Dbackend-gtk3=disabled",
                "-Dbackend-gtk4=enabled",
                "-Dbackend-qt5=disabled",
                "-Dbackend-qt6=disabled",
                "-Ddocs=false",
                "-Dtests=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/flatpak/libportal/releases/download/0.9.1/libportal-0.9.1.tar.xz",
                    "sha256": "de801ee349ed3c255a9af3c01b1a401fab5b3fc1c35eb2fd7dfb35d4b8194d7f"
                }
            ]
        },
        {
            "name": "haguichi",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/ztefn/haguichi/releases/download/1.5.4/haguichi-1.5.4.tar.xz",
                    "sha256": "f5eeff31070ac2c20bdd9c79c8a9903a936e9a9f518843086c0da8aa807ff74e"
                }
            ]
        }
    ]
}
